{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitroquicklook"],
  "ios": {
    "iosModuleName": "NitroQuickLook"
  },
  "android": {
    "androidNamespace": ["nitroquicklook"],
    "androidCxxLibName": "nitroquicklook"
  },
  "autolinking": {
    "QuickLook": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridQuickLook"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridQuickLook"
      }
    }
  },
  "ignorePaths": ["node_modules", "example/node_modules"]
}
