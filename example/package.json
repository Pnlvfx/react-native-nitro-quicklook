{
  "name": "react-native-nitro-quicklook-example",
  "version": "0.0.1",
  "private": true,
  "description": "React Native Nitro QuickLook Example",
  "type": "module",
  "scripts": {
    "android": "react-native run-android",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Debug",
    "ios": "react-native run-ios",
    "pod": "rm -rf ios/.xcode.env.local && cd ios && pod install",
    "start": "node tools/metro.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-blob-util": "^0.25.1",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-nitro-quicklook": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/react": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "execa": "^10.0.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-monorepo-config": "^0.4.0"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
